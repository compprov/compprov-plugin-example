<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.compprov</groupId>
    <artifactId>compprov-plugin-example</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>compprov-plugin-example</name>
    <description>
        Example of the extension for compprov-analytics. Usecase of ComputationEnvironment customization.
    </description>
    <url>https://github.com/compprov/compprov-plugin-example</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>mkabramyan</id>
            <name>Minas Abramyan</name>
            <url>https://github.com/compprov</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/compprov/compprov-plugin-example.git</connection>
        <developerConnection>scm:git:ssh://github.com/compprov/compprov-plugin-example.git</developerConnection>
        <url>https://github.com/compprov/compprov-plugin-example</url>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <junit.version>6.1.1</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.compprov</groupId>
            <artifactId>compprov-core</artifactId>
            <version>0.4.4</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai</artifactId>
            <version>1.17.2</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
            </plugin>
        </plugins>
    </build>
</project>